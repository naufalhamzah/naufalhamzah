---
/**
 * HERO — the homepage's focal point.
 *
 * The portrait is a tall panel that bleeds past the top of the section and
 * overlaps the type column slightly on desktop, so the image reads as part of
 * the layout rather than an illustration dropped next to it.
 *
 * The headline is the graduate positioning, NOT the employer; AirNav appears
 * only on the Experience page. IMAGE BUDGET: exactly ONE photograph.
 */
import { profile } from '@/data/profile';
import { asset, withBase } from '@/utils/url';

/** Split the name so the surname can be set in italic. */
const parts = profile.name.trim().split(/\s+/);
const first = parts.slice(0, -1).join(' ');
const last = parts[parts.length - 1] ?? '';

/** Focus axes, numbered; `profile.positioning` is the single source. */
const axes = profile.positioning;
---

<section class="hero" id="top">
  <div class="shell shell--wide hero__shell">
    <div class="hero__grid">
      <div class="hero__type">
        <div class="hero__top">
          <p class="hero__eyebrow label">{profile.displayWord}</p>

          {/*
            A live marker, not a badge. Nothing here changes, so it is not a live
            region — announcing a static string would be noise. The dot is
            decoration and hidden from assistive tech; the text carries the fact.
          */}
          <p class="hero__now mono">
            <span class="hero__dot" aria-hidden="true"></span>
            {profile.currentRole}
          </p>
        </div>

        <h1 class="hero__name">
          <span class="hero__name-line">{first}</span>
          <span class="hero__name-line hero__name-line--last"><em>{last}</em></span>
        </h1>

        <p class="hero__role">{profile.headline}</p>

        {/*
          THE LOWER BLOCK — this is what fills the dead space. The lead paragraph
          alone left ~220px of empty column to its right (644px column, only
          424px of text) and a gap under the role line. The focus axes now sit in
          that space, divided from the prose by a hairline, so the two read as
          one composed block.
        */}
        <div class="hero__lower">
          <p class="hero__lede">{profile.summary[0]}</p>

          <div class="hero__axes">
            <p class="hero__axes-h label">Focus</p>
            <ol class="hero__axes-list">
              {
                axes.map((a, i) => (
                  <li class="hero__axis">
                    <span class="hero__axis-n mono" aria-hidden="true">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <span class="hero__axis-t">{a}</span>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>

        <div class="hero__acts">
          <a href={withBase('/projects')} class="hero__btn hero__btn--solid">
            View selected work
            <span aria-hidden="true">→</span>
          </a>
          <a href={withBase('/about')} class="hero__btn hero__btn--ghost">About me</a>
        </div>
      </div>

      <figure class="hero__figure">
        <img
          class="hero__img"
          src={asset(profile.portrait.src)}
          alt={profile.portrait.alt}
          width={profile.portrait.width}
          height={profile.portrait.height}
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    </div>

    <div class="hero__meta">
      <span class="mono">{profile.location}</span>
      <span class="hero__meta-rule" aria-hidden="true"></span>
      <span class="mono">{profile.currentStatus}</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* The portrait is allowed to break the top edge, so the section clips. */
    overflow: hidden;
    /*
      Tightened from clamp(2.25rem, 5vw, 4rem): measured, the section ran 915px
      tall in a 900px viewport, which put the meta rule — location and status —
      just below the fold, where a half-visible rule reads as a mistake rather
      than a design. Reclaiming ~90px brings the whole hero into one screen.
    */
    padding-top: clamp(1.75rem, 4vw, 3rem);
  }

  .hero__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    grid-template-columns: 1fr;
    align-items: center;
  }

  @media (min-width: 940px) {
    .hero__grid {
      /*
        Type still leads, but the portrait is near parity (0.95fr against the old
        0.78fr). At 0.78fr it rendered 521px wide on a 1440px viewport and the
        user asked it to look "more real": too small and the eye treats a cut-out
        as a graphic in a box rather than a person in the page. ~1/3 larger, the
        face reaches a usable size and the stacked drop-shadows have enough
        silhouette to be legible.
      */
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
      gap: clamp(2rem, 4vw, 3.5rem);
      align-items: start;
    }
  }

  /*
    NO max-width on the column itself. An earlier `max-width: 20ch` resolved
    against the body font, not the display font, and collapsed the column to
    ~200px, wrapping the name into a narrow ribbon. The measure is constrained
    per element instead (the h1 and the lead paragraph).
  */
  @media (min-width: 940px) {
    .hero__type {
      padding-top: clamp(1.5rem, 4vw, 3.5rem);
      /* Sits above the portrait where they overlap. */
      position: relative;
      z-index: 2;
    }
  }

  .hero__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.25rem;
    margin-bottom: clamp(0.9rem, 2vw, 1.35rem);
  }

  .hero__eyebrow {
    /* The label carries its own leading rule; no extra margin needed. */
    margin-bottom: 0;
  }

  .hero__now {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.28rem 0.7rem 0.28rem 0.6rem;
    border: var(--hairline) solid var(--border);
    border-radius: var(--r-full);
    background-color: color-mix(in srgb, var(--surface-2) 60%, transparent);
    color: var(--fg-muted);
    text-transform: none;
    letter-spacing: 0.03em;
    font-size: var(--text-2xs);
  }

  /*
    The dot: a small accent point with a soft halo that breathes. Slow — 3s — so
    it reads as a heartbeat rather than an alarm, and it is the only motion in
    the hero on load.
  */
  .hero__dot {
    position: relative;
    width: 0.42rem;
    height: 0.42rem;
    flex: none;
    border-radius: var(--r-full);
    background-color: var(--accent);
  }

  .hero__dot::after {
    content: '';
    position: absolute;
    inset: -0.22rem;
    border-radius: var(--r-full);
    background-color: var(--accent);
    opacity: 0.28;
    animation: hero-pulse 3s var(--ease-inout) infinite;
  }

  @keyframes hero-pulse {
    0%,
    100% {
      transform: scale(0.7);
      opacity: 0.3;
    }
    50% {
      transform: scale(1.15);
      opacity: 0.08;
    }
  }

  .hero__name {
    font-family: var(--font-display);
    /* The largest type on the site — the hierarchy anchor everything else is
       measured against. */
    font-size: var(--text-display);
    font-weight: 500;
    line-height: 0.94;
    letter-spacing: -0.034em;
    color: var(--fg-strong);
  }

  .hero__name-line {
    display: block;
  }

  /* Italic surname: an editorial contrast move that stops the name reading as
     one long grey block. */
  .hero__name-line--last em {
    font-style: italic;
    position: relative;
    padding-inline-end: 0.12em;
  }

  /* Burgundy rule running out of the surname into the whitespace. */
  .hero__name-line--last em::after {
    content: '';
    position: absolute;
    left: calc(100% + 0.3em);
    top: 0.56em;
    width: clamp(1.5rem, 7vw, 6rem);
    height: 2px;
    background-color: var(--accent);
  }

  /*
    `line-height: 0.94` on a 3-line display heading leaves each line's descender
    box below the baseline, so the gap between the surname and the role measured
    ~50px where the margin asked for 14px. Pulling the role up by its own leading
    restores the intended rhythm without changing the name's tight leading.
  */
  .hero__role {
    margin-top: clamp(0.15rem, 0.6vw, 0.4rem);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-style: italic;
    color: var(--accent);
  }

  /*
    The lede alone left ~220px of empty column to its right; the axes sit there
    now, divided by a hairline so the two columns read as one composed block
    rather than two fragments.
  */
  .hero__lower {
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 2rem);
    grid-template-columns: 1fr;
    margin-top: clamp(1.1rem, 2.2vw, 1.5rem);
  }

  @media (min-width: 700px) {
    .hero__lower {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      gap: clamp(1.5rem, 3vw, 2.5rem);
      align-items: start;
    }
  }

  .hero__lede {
    max-width: 46ch;
    color: var(--fg-muted);
  }

  @media (min-width: 700px) and (max-width: 939px) {
    /* In this single-column band the lede has the full width; keep it readable. */
    .hero__lede {
      max-width: 58ch;
    }
  }

  .hero__axes {
    padding-inline-start: clamp(1rem, 2.5vw, 1.5rem);
    border-inline-start: var(--hairline) solid var(--border-faint);
  }

  @media (max-width: 699px) {
    .hero__axes {
      padding-inline-start: 0;
      padding-top: 1rem;
      border-inline-start: 0;
      border-top: var(--hairline) solid var(--border-faint);
    }
  }

  .hero__axes-h {
    display: block;
    margin-bottom: 0.7rem;
  }

  .hero__axes-list {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero__axis {
    display: grid;
    grid-template-columns: 1.6rem minmax(0, 1fr);
    gap: 0.4rem;
    align-items: baseline;
    font-size: var(--text-sm);
    color: var(--fg);
  }

  .hero__axis-n {
    color: var(--accent);
    font-size: var(--text-2xs);
    letter-spacing: 0.06em;
  }

  .hero__axis-t {
    text-wrap: balance;
  }

  .hero__acts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: clamp(1.4rem, 2.8vw, 1.9rem);
  }

  .hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.8rem 1.35rem;
    border: var(--hairline) solid transparent;
    border-radius: var(--r-xs);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition:
      background-color var(--t-base) var(--ease),
      border-color var(--t-base) var(--ease),
      color var(--t-base) var(--ease),
      transform var(--t-base) var(--ease);
  }

  .hero__btn--solid {
    background-color: var(--solid-bg);
    color: var(--on-solid);
  }

  .hero__btn--solid:hover {
    background-color: var(--solid-bg-hover);
    transform: translateY(-1px);
  }

  .hero__btn--ghost {
    border-color: var(--border-strong);
    color: var(--fg);
  }

  .hero__btn--ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
    background-color: var(--accent-soft);
  }

  /*
    THE PORTRAIT IS A CUT-OUT — the source has no backdrop (~40% of pixels are
    fully transparent), so the silhouette is the only thing in the file. A filled
    plate, a 1px border, rounded corners or a box-shadow all draw a RECTANGLE
    around a person who has none, which is exactly what makes a cut-out read as
    "pasted on". Hence: no border, no frame, no radius. Depth comes from
    `drop-shadow` (which follows the alpha silhouette) and a bottom fade.
  */
  .hero__figure {
    position: relative;
    margin: 0;
    isolation: isolate;
  }

  /* Deliberately NO background pool here. An earlier soft elliptical lift
     measured as a 4-unit colour step exactly at the frame edge, which the eye
     found as a shape; it read as a beige plate, not depth. */

  @media (min-width: 940px) {
    .hero__figure {
      /* Pulled up so the cut-out breaks past the section's top padding and the
         composition feels cropped rather than contained. */
      margin-top: clamp(-5rem, -6vw, -2rem);
    }
  }

  .hero__img {
    position: relative;
    display: block;
    /*
      SIZED AS A REPLACED ELEMENT, NOT AS A BOX. `width: 100%` plus a `max-height`
      does not shrink the portrait, it LETTERBOXES it: measured, box ratio 0.874
      against a natural 0.75, so the image looked smaller with invisible padding
      on both sides. An <img> with `width: auto`, `max-width: 100%` and
      `max-height` fits the largest rectangle satisfying BOTH caps at the
      intrinsic ratio, so the box always equals the image.

      The `max-height` lives here, not on the <figure>: a max-height on an
      auto-height grid item has nothing to resolve against and is silently
      ignored. The cap keeps the portrait — which sets the hero's height in every
      measured viewport — from pushing the meta rule below the fold. `svh`, not
      `vh`, because on mobile Safari the visible height changes as browser chrome
      slides.
    */
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: calc(100svh - 9.5rem);
    /* Scaled down, it stays centred in its column rather than jumping to the
       left edge of a wider track. */
    margin-inline: auto;
    /*
      NO OUTLINE ON THE IMAGE. The global `:focus-visible` rule draws a 3px accent
      outline and the hero <img> receives focus on load, so a rectangle was drawn
      around a cut-out that has no rectangle (the user reported it as a "border").
      An image is not an interactive control, so the ring signals an affordance
      that does not exist; nothing is lost for keyboard users.

      `!important` is load-bearing: the global rule sets BOTH `outline` and
      `outline-offset`, and a plain `outline: none` does not neutralise the offset
      on some engines.
    */
    outline: none !important;
    outline-offset: 0 !important;
    /*
      `drop-shadow`, NOT `box-shadow`: box-shadow draws around the element's BOX,
      painting a rectangle behind a person who has none (the "sticker" look).
      drop-shadow is applied to the rendered ALPHA, so the shadow traces the
      actual silhouette. Three stacked: a tight contact shadow to seat the
      figure, a mid shadow for separation, and a wide soft one for the ambient
      falloff the eye reads as "occupying space". One alone reads as a graphic
      cut-out; the stack is what makes it photographic.
    */
    filter: var(--photo-filter) drop-shadow(
        0 1px 2px rgba(0, 0, 0, 0.45)
      ) drop-shadow(0 4px 10px rgba(0, 0, 0, 0.28))
      drop-shadow(0 14px 28px rgba(0, 0, 0, 0.26))
      drop-shadow(0 34px 60px rgba(0, 0, 0, 0.30));
    /*
      THE BOTTOM FADE removes the "patahan": a cut-out ending on a straight
      horizontal line reads as a torn photograph. A long, even ramp over the last
      third dissolves that edge — an earlier curve dropped from solid to 0.2 in
      the last fifth, which is a visible gradient band rather than a dissolve.

      Order matters: filtering happens before masking, so each drop-shadow is
      computed from the full silhouette and then fades with it, leaving no shadow
      edge floating below the figure.
    */
    mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 66%,
      rgba(0, 0, 0, 0.86) 76%,
      rgba(0, 0, 0, 0.52) 87%,
      rgba(0, 0, 0, 0.18) 95%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 66%,
      rgba(0, 0, 0, 0.86) 76%,
      rgba(0, 0, 0, 0.52) 87%,
      rgba(0, 0, 0, 0.18) 95%,
      transparent 100%
    );
  }

  /*
    LIGHT THEME: A TIGHT STACK, NO WIDE AMBIENT BLUR.

    The dark theme's fourth shadow — 34px offset at 56px blur — is invisible on a
    near-black canvas, but on ivory it spreads into a warm haze. Measured on the
    live page across the figure's mid-body it reached a 36-unit colour step, and
    because the haze covers the image's whole WIDTH it reads as a rectangular
    panel behind the portrait rather than as depth. Confirmed by sampling: the
    step was 0 above the head, where no body casts a shadow, and peaked exactly
    where the torso is widest.

    So on paper the stack stops at the soft shadow. Three drop-shadows still seat
    the figure (contact, mid, soft) without drawing a box around it.
  */
  :global([data-theme='light']) .hero__img {
    filter: var(--photo-filter) drop-shadow(
        0 1px 2px rgba(62, 46, 30, 0.28)
      ) drop-shadow(0 5px 12px rgba(62, 46, 30, 0.12))
      drop-shadow(0 16px 30px rgba(62, 46, 30, 0.08));
  }

  /*
    INTERACTION — small, and only where a pointer exists.

    The figure drifts a few pixels toward the cursor so the portrait reads as a
    plane in front of the page rather than a picture pasted onto it. The script at
    the foot of this file writes `--par-x` / `--par-y`; with no script they stay
    at zero and every rule below collapses to a no-op, so this is an enhancement
    rather than a dependency.
  */
  .hero__figure {
    transform: translate3d(var(--par-x, 0px), var(--par-y, 0px), 0);
    transition: transform 400ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* The portrait resolves rather than snapping in. Opacity only, so the hover
     transform below is free to use `transform` for itself. */
  .hero__img {
    animation: hero-img-in 900ms var(--ease) 90ms both;
  }

  @keyframes hero-img-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* Hover acknowledges the pointer with a lift and a marginally deeper shadow.
     `hover: hover` keeps it off touch devices, where a tap would leave the
     figure stuck in its hover state. */
  @media (hover: hover) and (pointer: fine) {
    .hero__img {
      transition:
        transform 520ms var(--ease),
        filter 520ms var(--ease);
    }

    .hero__figure:hover .hero__img {
      transform: translateY(-4px) scale(1.012);
    }
  }

  .hero__meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    /*
      Tightened twice, most recently from clamp(2.5rem, 5vw, 4rem): measured, the
      meta rule still landed at y=897 in a 900px viewport — technically visible,
      visually sliced. The figure is taller than the type column, so it sets this
      section's height and the meta rides down with it; the rule has to sit close
      under the columns for the whole hero to fit one screen.
    */
    margin-top: clamp(1.25rem, 2.5vw, 2rem);
    padding-top: 1.1rem;
    border-top: var(--hairline) solid var(--border);
  }

  .hero__meta-rule {
    flex: 1;
    height: 1px;
    background-color: var(--border-faint);
  }

  @media (max-width: 939px) {
    /*
      Portrait first, and given more room than the 13rem it used to take. At
      13rem (~208px) the figure rendered under 190px tall on a phone — the face
      was too small to read as a person, which is the same defect the desktop
      column had at 0.78fr. 17rem keeps it an introduction rather than a
      full-bleed poster while letting the face carry.
    */
    .hero__figure {
      order: -1;
      width: 100%;
      max-width: 17rem;
      margin-inline: auto;
    }

    /* The surname's trailing rule shortens on narrow screens so it never wraps
       onto a line of its own. */
    .hero__name-line--last em::after {
      width: clamp(1.25rem, 12vw, 3.5rem);
    }

    .hero__lede {
      max-width: none;
    }
  }

  @media (max-width: 560px) {
    .hero__meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.3rem;
    }

    .hero__meta-rule {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* The drift is decoration, so it is removed rather than softened. */
    .hero__figure {
      transform: none;
      transition: none;
    }

    .hero__img {
      animation: none;
    }

    /* The pulse is decoration. A visitor who asked for less motion gets a still
       dot rather than a disabled one — the status fact is in the text either
       way. */
    .hero__dot::after {
      animation: none;
      opacity: 0.22;
      transform: scale(1);
    }

    .hero__btn--solid:hover {
      transform: none;
    }
  }
</style>
<script>
  /*
    POINTER DRIFT — a few pixels, nothing more.

    Kept deliberately tiny, because the site otherwise ships no client JavaScript
    outside /projects and that is worth preserving. This is the one exception: a
    CSS-only parallax needs `animation-timeline: view()`, which cannot follow a
    cursor.

    Not a dependency. The CSS reads `--par-x` / `--par-y` with a 0px fallback, so
    with this script blocked or failing the portrait simply sits still — no
    layout shift, no missing content.

    Skipped entirely when the visitor asked for reduced motion, and on touch
    devices, where there is no cursor to follow.
  */
  const hero = document.querySelector<HTMLElement>('.hero');
  const figure = document.querySelector<HTMLElement>('.hero__figure');
  const wantsStill = window.matchMedia('(prefers-reduced-motion: reduce)');
  const hasPointer = window.matchMedia('(hover: hover) and (pointer: fine)');

  if (hero && figure && hasPointer.matches && !wantsStill.matches) {
    const STRENGTH = 10;
    let tx = 0;
    let ty = 0;
    let frame = 0;

    const apply = () => {
      frame = 0;
      figure.style.setProperty('--par-x', tx.toFixed(2) + 'px');
      figure.style.setProperty('--par-y', ty.toFixed(2) + 'px');
    };

    const queue = () => {
      if (!frame) frame = requestAnimationFrame(apply);
    };

    hero.addEventListener('pointermove', (event: PointerEvent) => {
      const r = hero.getBoundingClientRect();
      tx = ((event.clientX - r.left) / r.width - 0.5) * 2 * STRENGTH;
      ty = ((event.clientY - r.top) / r.height - 0.5) * 2 * STRENGTH;
      queue();
    });

    hero.addEventListener('pointerleave', () => {
      tx = 0;
      ty = 0;
      queue();
    });
  }
</script>
