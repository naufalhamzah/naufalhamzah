---
/**
 * ABOUT — the full professional background: everything the homepage preview
 * omits — the narrative, how I work, education, and the organisational record.
 *
 * The organisational section lives here rather than on its own page because it
 * is background, not a portfolio category, and it keeps the main navigation to
 * eight destinations (the brief).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import Collage from '@/components/ui/Collage.astro';
import { profile } from '@/data/profile';
import { educationSorted } from '@/data/education';
import { organizationsSorted, organizationGroups } from '@/data/organizations';
import { experienceSorted } from '@/data/experience';
import { skillGroups } from '@/data/skills';
import { asset, withBase } from '@/utils/url';

const education = educationSorted;

/**
 * Organisational roles grouped by parent body, newest first inside each group.
 * `organizationGroups` is derived, so a new body appears here automatically.
 */
const orgsByGroup = organizationGroups.map((g) => ({
  group: g,
  roles: organizationsSorted.filter((o) => o.group === g),
}));

/**
 * The snapshot sections, all derived from the data layer — nothing here is a new
 * claim, only a re-presentation of existing records. Each is deliberately
 * CAPPED: About is a background page, not a second Experience or Skills page.
 */

/** Three most recent roles. */
const experienceSnapshot = experienceSorted.slice(0, 3);

/**
 * WHAT I LEAD WITH — four of the nine groups, not all nine.
 *
 * The source material covers nine areas, and listing every one of them turned
 * this row into a table of contents: it read as "I do everything", which is the
 * opposite of the narrowing the brief asks for. /skills carries the complete
 * inventory and this block links to it, so nothing is hidden by showing less.
 *
 * CHOSEN BY EVIDENCE, NOT PREFERENCE. All four are anchored in documented work:
 * the published research (KNN, Naive Bayes), the analytics on two internships
 * (Looker Studio at PLN Pusharlis, Excel and Sheets in the Beauty Innovation
 * data system), and the systems themselves (Google Apps Script there, Python,
 * SQL and JavaScript across the project record). The remaining five — ML,
 * networking, IT support, office and collaboration tooling, design — are real
 * but sit further from the work this site is positioning.
 */
const FEATURED_SKILLS = [
  'Data Analytics & Visualization',
  'Programming & Database',
  'Business Process & Analysis',
  'Design & Creative',
];

/** Resolved against the data so a renamed group can never silently vanish. */
const skillIndex = FEATURED_SKILLS.map(
  (title) => skillGroups.find((g) => g.title === title)?.title,
).filter((t): t is string => Boolean(t));

/**
 * INTERESTS — the four positioning axes, one plain sentence each. Labels come
 * from `profile.positioning`; the sentences only restate what the summary and
 * project record already say. No new field is introduced.
 */
const interests = [
  {
    label: 'Data',
    text: 'Reading a dataset well enough to say what decision it should support — dashboards, reporting and the validation work that makes both trustworthy.',
  },
  {
    label: 'Technology',
    text: 'Building the tool rather than only specifying it: information systems, automation, and the code that connects them.',
  },
  {
    label: 'Business Process',
    text: 'Mapping how work actually flows before changing it, then documenting requirements so the result fits the team using it.',
  },
  {
    label: 'Digital Solutions',
    text: 'Product thinking on interface and flow — the three UI/UX case studies in the portfolio come from this side of the work.',
  },
];

/**
 * The personal photographs this page uses — PHOTOGRAPHS, not product screenshots.
 *
 * A spreadsheet was removed from this array: its meaning lives in its text, and
 * at strip size that text is unreadable, so it read as a broken image.
 * Screenshots belong in the project galleries where they render full width (the
 * marketing system's gallery image). Two frames also balance better than three.
 */
const photos = [
  {
    src: '/images/experience/ppk-ormawa.webp',
    alt: 'PPK Ormawa field programme team photograph',
    caption: 'PPK Ormawa field programme',
  },
  {
    src: '/images/experience/airnav-onboarding.webp',
    alt: 'AirNav Indonesia onboarding session',
    caption: 'Onboarding at AirNav Indonesia',
  },
];

const meta = [
  { label: 'Based in', value: profile.location },
  { label: 'Focus', value: profile.focusAreas.slice(0, 3).join(' · ') },
  { label: 'Field', value: 'Information Systems' },
  { label: 'Education', value: 'Universitas Negeri Semarang, 2022 – 2026' },
];
---

<BaseLayout
  title={`About — ${profile.name}`}
  description="Background, focus areas and experience of Hamzah Naufal Zuhdi — Information Systems graduate working across data analytics, information systems and business process improvement."
>
  <PageHeader
    index="01"
    eyebrow="About"
    title="Background and focus"
    standfirst="An Information Systems graduate who works where data, business process and technology meet — analysing how something currently works, then building the system or dashboard that makes it work better."
    meta={meta}
  />

  <!-- ===================== narrative ===================== -->
  <section class="ab" aria-labelledby="ab-story">
    <div class="shell ab__shell">
      <div class="ab__main">
        <h2 id="ab-story" class="sr-only">Background</h2>
        {
          profile.summary.map((p, i) => (
            <p class:list={['ab__p', i === 0 && 'ab__p--lead']}>{p}</p>
          ))
        }
      </div>

      <aside class="ab__side" aria-labelledby="ab-focus">
        <h3 id="ab-focus" class="label ab__side-h">Focus areas</h3>
        <ul class="ab__focus">
          {profile.focusAreas.map((f) => <li class="ab__chip mono">{f}</li>)}
        </ul>

        <h3 class="label ab__side-h ab__side-h--2">What I work on</h3>
        <ul class="ab__ways">
          {
            [
              'Mapping a process before changing it',
              'Turning raw data into a view someone can act on',
              'Building tools that survive handover, not one-off reports',
              'Documenting requirements so the result fits how a team works',
            ].map((w) => <li class="ab__way">{w}</li>)
          }
        </ul>
      </aside>
    </div>
  </section>

  <!-- ===================== interests ===================== -->
  <section class="ab-int" aria-labelledby="ab-interests">
    <div class="shell">
      <div class="ab-int__head">
        <h2 id="ab-interests" class="label">Interests</h2>
        <p class="ab-int__lede">
          Four axes, and what each one means in practice.
        </p>
      </div>

      <ul class="ab-int__grid">
        {
          interests.map((it, i) => (
            <li class="ab-int__item">
              <p class="ab-int__n mono" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </p>
              <h3 class="ab-int__label">{it.label}</h3>
              <p class="ab-int__text">{it.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ===================== selected photographs ===================== -->
  <section class="ab-ph" aria-labelledby="ab-photos">
    <div class="shell">
      <h2 id="ab-photos" class="label ab-ph__h">Selected photographs</h2>
      <Collage images={photos} caption="Working and programme contexts. These are not attributed to a single employer — see the Gallery page for the full set." />
    </div>
  </section>

  <!-- ===================== education ===================== -->
  <section class="ab-ed" aria-labelledby="ab-edu">
    <div class="shell">
      <h2 id="ab-edu" class="label ab-ed__h">Education</h2>

      <ol class="ab-ed__list">
        {
          education.map((e) => (
            <li class="ab-ed__row">
              <div class="ab-ed__logo">
                {e.logo ? (
                  <img
                    src={asset(e.logo.src)}
                    alt={e.logo.alt}
                    width={e.logo.width ?? 120}
                    height={e.logo.height ?? 120}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="mono ab-ed__logo-fb">{e.institution.charAt(0)}</span>
                )}
              </div>

              <div class="ab-ed__body">
                <p class="ab-ed__when mono">{e.dateRange}</p>
                <h3 class="ab-ed__school">{e.institution}</h3>
                <p class="ab-ed__degree">
                  {e.degree}
                  {e.field && ` — ${e.field}`}
                </p>
                {e.highlights && e.highlights.length > 0 && (
                  <ul class="ab-ed__notes">
                    {e.highlights.map((h) => <li>{h}</li>)}
                  </ul>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ===================== organisations ===================== -->
  <section class="ab-org" id="organizations" aria-labelledby="ab-orgs">
    <div class="shell">
      <div class="ab-org__head">
        <h2 id="ab-orgs" class="label">Organisations &amp; leadership</h2>
        <p class="ab-org__count mono">
          {organizationsSorted.length} roles · {organizationGroups.length} bodies
        </p>
      </div>

      <p class="ab-org__lede">
        Student-body and committee roles held alongside my studies — the part of the
        record that shaped how I plan, coordinate and communicate across teams.
      </p>

      {
        orgsByGroup.map(({ group, roles }) => (
          <div class="ab-org__group">
            <h3 class="ab-org__group-name mono">{group}</h3>

            <ol class="ab-org__list">
              {roles.map((r) => (
                <li class="ab-org__row">
                  <p class="ab-org__when mono">{r.dateRange}</p>
                  <div class="ab-org__body">
                    <p class="ab-org__role">{r.role}</p>
                    {r.location && <p class="ab-org__loc mono">{r.location}</p>}
                  </div>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ===================== experience snapshot ===================== -->
  <section class="ab-xp" aria-labelledby="ab-xp">
    <div class="shell">
      <div class="ab-xp__head">
        <h2 id="ab-xp" class="label">Experience snapshot</h2>
        <a href={withBase('/experience')} class="ab-xp__more mono">Full experience →</a>
      </div>

      <ol class="ab-xp__list">
        {
          experienceSnapshot.map((e) => (
            <li class="ab-xp__row">
              <p class="ab-xp__when mono">{e.dateRange}</p>
              <div class="ab-xp__body">
                <p class="ab-xp__role">{e.role}</p>
                <p class="ab-xp__org">{e.company}</p>
                {e.current && <span class="ab-xp__now mono">Current</span>}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ===================== what I work with ===================== -->
  <section class="ab-sk" aria-labelledby="ab-sk">
    <div class="shell">
      <div class="ab-sk__head">
        <h2 id="ab-sk" class="label">What I work with</h2>
        <a href={withBase('/skills')} class="ab-sk__more mono">All skills →</a>
      </div>

      <ul class="ab-sk__grid">
        {skillIndex.map((t) => <li class="ab-sk__item mono">{t}</li>)}
      </ul>
    </div>
  </section>

  <!-- ===================== onward ===================== -->
  <section class="ab-go">
    <div class="shell ab-go__shell">
      <a href={withBase('/experience')} class="ab-go__link">
        <span class="ab-go__label mono">Next</span>
        <span class="ab-go__title">Professional experience</span>
        <span class="ab-go__arrow" aria-hidden="true">→</span>
      </a>
      <a href={withBase('/projects')} class="ab-go__link">
        <span class="ab-go__label mono">Also</span>
        <span class="ab-go__title">Selected projects</span>
        <span class="ab-go__arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .ab {
    padding-block: clamp(2rem, 4vw, 3rem) var(--space-section);
  }

  .ab__shell {
    display: grid;
    gap: clamp(2rem, 4.5vw, 4rem);
    grid-template-columns: 1fr;
  }

  @media (min-width: 900px) {
    .ab__shell {
      grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  .ab__p {
    max-width: 68ch;
    color: var(--fg-muted);
  }

  .ab__p + .ab__p {
    margin-top: 1.15rem;
  }

  /* The opening paragraph is set larger — the editorial lead-in. */
  .ab__p--lead {
    font-size: var(--text-lg);
    color: var(--fg);
  }

  .ab__side {
    padding-top: 0.35rem;
  }

  .ab__side-h {
    display: block;
    color: var(--accent);
  }

  .ab__side-h--2 {
    margin-top: 2.25rem;
  }

  .ab__focus {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.5rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .ab__chip {
    padding: 0.3rem 0.7rem;
    border: var(--hairline) solid var(--border-strong);
    border-radius: var(--r-full);
    color: var(--fg-subtle);
    text-transform: none;
    letter-spacing: 0.03em;
  }

  .ab__ways {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .ab__way {
    padding: 0.7rem 0;
    border-top: var(--hairline) solid var(--border-faint);
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  .ab__way:last-child {
    border-bottom: var(--hairline) solid var(--border-faint);
  }

  .ab-int {
    padding-block: var(--space-section);
    border-top: var(--hairline) solid var(--border);
  }

  .ab-int__head {
    display: grid;
    gap: 0.6rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }

  .ab-int__lede {
    max-width: 46ch;
    color: var(--fg-muted);
  }

  /* Four cards, but NOT boxed: a hairline along the top edge only, so the set
     reads as one ruled register rather than four tiles (the brief's "less
     clutter, not card-heavy"). The number anchors the eye without a bullet. */
  .ab-int__grid {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    grid-template-columns: 1fr;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 700px) {
    .ab-int__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .ab-int__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .ab-int__item {
    padding-top: 1.1rem;
    border-top: var(--hairline) solid var(--border-strong);
  }

  .ab-int__n {
    color: var(--accent);
  }

  .ab-int__label {
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 500;
    color: var(--fg-strong);
  }

  .ab-int__text {
    margin-top: 0.6rem;
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--fg-muted);
  }

  .ab-xp,
  .ab-sk {
    padding-block: var(--space-section);
    border-top: var(--hairline) solid var(--border);
  }

  .ab-xp__head,
  .ab-sk__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-bottom: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .ab-xp__more,
  .ab-sk__more {
    color: var(--accent);
    text-transform: none;
    letter-spacing: 0.03em;
  }

  .ab-xp__more:hover,
  .ab-sk__more:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .ab-xp__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ab-xp__row {
    display: grid;
    gap: 0.2rem 1.5rem;
    grid-template-columns: 1fr;
    padding: 1rem 0;
    border-bottom: var(--hairline) solid var(--border-faint);
  }

  .ab-xp__row:first-child {
    border-top: var(--hairline) solid var(--border-faint);
  }

  @media (min-width: 760px) {
    .ab-xp__row {
      grid-template-columns: minmax(0, 13rem) minmax(0, 1fr);
      align-items: baseline;
    }
  }

  .ab-xp__when {
    color: var(--fg-faint);
    text-transform: none;
    letter-spacing: 0.03em;
  }

  .ab-xp__role {
    font-size: var(--text-base);
    color: var(--fg);
  }

  .ab-xp__org {
    margin-top: 0.15rem;
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  .ab-xp__now {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.2rem 0.6rem;
    border: var(--hairline) solid var(--accent-line);
    border-radius: var(--r-full);
    color: var(--accent);
  }

  .ab-sk__grid {
    display: grid;
    gap: 0.6rem 1rem;
    /*
      `auto-fit` rather than fixed column counts. The list is a curated four
      instead of the full nine, and fixed counts left one orphan sitting alone on
      a second row at desktop width. With a minimum track the row resolves itself:
      four across when there is room, two on a tablet, one on a phone.
    */
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ab-sk__item {
    padding: 0.65rem 0.9rem;
    border-inline-start: 2px solid var(--accent-line);
    background-color: var(--surface);
    color: var(--fg-subtle);
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .ab-ph {
    padding-block: var(--space-section);
    border-top: var(--hairline) solid var(--border);
  }

  .ab-ph__h {
    margin-bottom: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .ab-ed {
    padding-block: var(--space-section);
    background-color: var(--band);
    border-block: var(--hairline) solid var(--border-faint);
  }

  .ab-ed__h {
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }

  .ab-ed__list {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ab-ed__row {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: clamp(1.25rem, 3vw, 2rem);
    align-items: start;
  }

  .ab-ed__logo {
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    padding: 0.5rem;
    border: var(--hairline) solid var(--border);
    border-radius: var(--r-xs);
    background-color: var(--surface-2);
    overflow: hidden;
  }

  /* max-* not width/height:100% — a percentage height does not resolve inside a
     centred grid item, so a square crest (600×600) would overflow the plate. */
  .ab-ed__logo img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .ab-ed__logo-fb {
    font-size: 1.5rem;
    color: var(--accent);
  }

  .ab-ed__when {
    color: var(--fg-faint);
  }

  .ab-ed__school {
    margin-top: 0.35rem;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 500;
    color: var(--fg-strong);
  }

  .ab-ed__degree {
    margin-top: 0.25rem;
    color: var(--fg-muted);
  }

  .ab-ed__notes {
    margin: 0.9rem 0 0;
    padding-inline-start: 1.1rem;
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }

  .ab-ed__notes li + li {
    margin-top: 0.35rem;
  }

  .ab-org {
    padding-block: var(--space-section);
  }

  .ab-org__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding-bottom: 1rem;
    border-bottom: var(--hairline) solid var(--border);
  }

  .ab-org__count {
    color: var(--fg-faint);
  }

  .ab-org__lede {
    margin-top: 1.25rem;
    max-width: 62ch;
    color: var(--fg-muted);
  }

  .ab-org__group {
    margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .ab-org__group-name {
    color: var(--accent);
    padding-bottom: 0.6rem;
    border-bottom: var(--hairline) solid var(--border-faint);
  }

  .ab-org__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ab-org__row {
    display: grid;
    gap: 0.2rem 1.5rem;
    grid-template-columns: 1fr;
    padding: 0.85rem 0;
    border-bottom: var(--hairline) solid var(--border-faint);
  }

  @media (min-width: 760px) {
    .ab-org__row {
      grid-template-columns: minmax(0, 13rem) minmax(0, 1fr);
      align-items: baseline;
    }
  }

  .ab-org__when {
    color: var(--fg-faint);
    text-transform: none;
    letter-spacing: 0.03em;
  }

  .ab-org__role {
    font-size: var(--text-sm);
    color: var(--fg);
  }

  .ab-org__loc {
    margin-top: 0.15rem;
    color: var(--fg-faint);
    text-transform: none;
  }

  .ab-go {
    padding-block: var(--space-band) var(--space-section);
    border-top: var(--hairline) solid var(--border);
  }

  .ab-go__shell {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 700px) {
    .ab-go__shell {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .ab-go__link {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.2rem 1rem;
    padding: 1.1rem 1.25rem;
    border: var(--hairline) solid var(--border-strong);
    border-radius: var(--r-xs);
    transition:
      border-color var(--t-base) var(--ease),
      background-color var(--t-base) var(--ease);
  }

  .ab-go__link:hover {
    border-color: var(--accent);
    background-color: var(--accent-soft);
  }

  .ab-go__label {
    grid-column: 1 / -1;
    color: var(--fg-faint);
  }

  .ab-go__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--fg-strong);
  }

  .ab-go__arrow {
    color: var(--accent);
    transition: transform var(--t-base) var(--ease);
  }

  .ab-go__link:hover .ab-go__arrow {
    transform: translateX(4px);
  }
</style>
